{% extends 'layout.html' %}

{% block title %}AI Document Insights Settings{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-robot me-2"></i> AI Document Insights Settings
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <div class="alert {% if is_enabled %}alert-success{% else %}alert-warning{% endif %}">
                                <h5>
                                    <i class="fas {% if is_enabled %}fa-check-circle{% else %}fa-exclamation-triangle{% endif %} me-2"></i>
                                    AI Document Insights Status
                                </h5>
                                {% if is_enabled %}
                                    <p>AI document insights are <strong>enabled</strong>. The system can provide intelligent analysis of your documents, quotations, and invoices.</p>
                                {% else %}
                                    <p>AI document insights are <strong>disabled</strong>. To enable this feature, please provide your OpenAI API key below.</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8">
                            <h5 class="mb-3">Configure OpenAI API Key</h5>
                            <form method="POST">
                                <div class="mb-3">
                                    <label for="openai_api_key" class="form-label">OpenAI API Key</label>
                                    <div class="input-group">
                                        <input type="password" class="form-control" id="openai_api_key" name="openai_api_key" 
                                               placeholder="{% if api_key_set %}•••••••••••••••••••••••••••{% else %}Enter your OpenAI API key{% endif %}" 
                                               autocomplete="off">
                                        <button class="btn btn-outline-secondary" type="button" id="toggleApiKey">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                    <div class="form-text">
                                        {% if api_key_set %}
                                            Your API key is currently set and securely stored.
                                        {% else %}
                                            You can get an API key from your <a href="https://platform.openai.com/account/api-keys" target="_blank">OpenAI account</a>.
                                        {% endif %}
                                    </div>
                                </div>
                                
                                <div class="mb-3">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-2"></i> Save API Key
                                    </button>
                                    {% if api_key_set %}
                                    <button type="button" class="btn btn-outline-primary ms-2" id="testApiKey">
                                        <i class="fas fa-vial me-2"></i> Test Connection
                                    </button>
                                    {% endif %}
                                </div>
                            </form>
                        </div>
                        <div class="col-md-4">
                            <div class="card h-100">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="fas fa-info-circle me-2"></i> About AI Document Insights
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <p>The AI Document Insights feature provides intelligent analysis of your:</p>
                                    <ul>
                                        <li>Uploaded Excel price lists</li>
                                        <li>Processed PDF invoices</li>
                                        <li>Customer quotations</li>
                                        <li>Supplier products for duplicate detection</li>
                                    </ul>
                                    <p>The system uses OpenAI's powerful models to extract relevant insights, detect patterns, and suggest optimizations for your plant nursery business.</p>
                                    <p><strong>Note:</strong> Your documents are analyzed securely, and no sensitive data is stored by OpenAI.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    // Toggle API key visibility
    document.getElementById('toggleApiKey').addEventListener('click', function() {
        const apiKeyInput = document.getElementById('openai_api_key');
        const eyeIcon = this.querySelector('i');
        
        if (apiKeyInput.type === 'password') {
            apiKeyInput.type = 'text';
            eyeIcon.classList.remove('fa-eye');
            eyeIcon.classList.add('fa-eye-slash');
        } else {
            apiKeyInput.type = 'password';
            eyeIcon.classList.remove('fa-eye-slash');
            eyeIcon.classList.add('fa-eye');
        }
    });

    // Test API key connection
    const testButton = document.getElementById('testApiKey');
    if (testButton) {
        testButton.addEventListener('click', function() {
            this.disabled = true;
            const originalText = this.innerHTML;
            this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Testing...';
            
            // Send request to test endpoint
            fetch('/test-openai-api')
                .then(response => response.json())
                .then(data => {
                    this.disabled = false;
                    this.innerHTML = originalText;
                    
                    if (data.success) {
                        // Show success message
                        Swal.fire({
                            title: 'Connection Successful!',
                            text: data.message,
                            icon: 'success',
                            confirmButtonText: 'Ok'
                        });
                    } else {
                        // Show error message
                        Swal.fire({
                            title: 'Connection Failed',
                            text: data.message,
                            icon: 'error',
                            confirmButtonText: 'Ok'
                        });
                    }
                })
                .catch(error => {
                    this.disabled = false;
                    this.innerHTML = originalText;
                    
                    // Show error message
                    Swal.fire({
                        title: 'Error',
                        text: 'An error occurred while testing the API connection. Please try again.',
                        icon: 'error',
                        confirmButtonText: 'Ok'
                    });
                });
        });
    }
</script>
{% endblock %}